# ئەم فایلە کۆپی بکە بۆ .env بۆ تێستی لۆکاڵ، یان هەمان ناوەکان
# وەک Environment Variables لە Railway دابنێ (Settings > Variables).
# .env هەرگیز مەیخە سەر GitHub (لە .gitignore دایە).

METAAPI_TOKEN=your_free_metaapi_token_here

# یەکێک لەمانە پڕبکەرەوە (دیمۆ/ڕیاڵ) — ئەگەر پێشتر هەژمارت لە MetaApi provision کردووە
METAAPI_ACCOUNT_ID_DEMO=
METAAPI_ACCOUNT_ID_REAL=

# یان بۆ provisioning ئۆتۆماتیکی یەکەم جار (ئەگەر METAAPI_ACCOUNT_ID بەتاڵ بێت):
MT5_LOGIN=your_exness_mt5_login
MT5_PASSWORD=your_exness_mt5_password
MT5_SERVER=Exness-MT5Real

ACCOUNT_MODE=demo

SYMBOL=XAUUSD
RISK_PERCENT_PER_TRADE=30
MAX_OPEN_TRADES=1
SL_BUFFER_USD=1.5
RISK_REWARD_RATIO=2.0
POLL_INTERVAL_SECONDS=60

DRY_RUN=True
